reads_ori=$1
reads_corr=$2
high_contig=$3
outp_refix=$4
compress=$5
correct_reads_script=$6

if [ ! -f "$outprefix.compressed_reads.fasta" ]; then
    /Poppy/zmzhang/Consensus_Assembly/cLJA/lib/LJA/bin/compress --dimer-compress 32,32,1 --reads $reads > $outprefix.compressed_reads.fasta
fi

if [ ! -f "$outprefix.bam" ]; then
    minimap2 -t 50 -ax map-hifi --eqx $highcontig $outprefix.compressed_reads.fasta | samtools sort -@ 50 -o $outprefix.bam
    samtools index $outprefix.bam
fi

python /Poppy/zmzhang/Consensus_Assembly/cLJA/src/scripts/correct_reads_high.py -b correct_high.bam -c graph.ori.only_high.fasta -i correct_high.compressed_reads.fasta -o correct_high.compressed_reads.corrected.fasta